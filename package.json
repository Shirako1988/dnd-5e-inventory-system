{
  "name": "dnd-inventory-manager-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/resources.test.ts tests/itemEditGuard.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-inventory --non-interactive \"node --import tsx --test tests/firestore.test.ts\"",
    "test:browser": "node tests/browser.mjs",
    "catalog:resources": "python scripts/build-resource-catalog.py"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "firebase-tools": "14.22.0",
    "playwright": "1.62.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
